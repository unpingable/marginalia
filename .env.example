# Recommended: let Docker mount the NFS export directly at /backups. This also
# works with confined Docker installations that cannot see host NFS mounts.
MARGINALIA_BACKUP_NFS_HOST=nas.example.lan
MARGINALIA_BACKUP_NFS_EXPORT=/tank/nfs/marginalia
MARGINALIA_BACKUP_NFS_VERSION=4
MARGINALIA_BACKUP_NFS_VOLUME=marginalia_backups_nfs
MARGINALIA_BACKUP_REQUIRE_REMOTE=true

# Fallback for Docker installations that can see a host-mounted NAS. Leave the
# NFS variables above unset and configure this instead.
# MARGINALIA_BACKUP_HOST_PATH=/tank/nfs/marginalia

# Configured model ID used only for derived context maintenance.
# It must exist and be available in MARGINALIA_MODEL_CONFIG before context build.
MARGINALIA_CONTEXT_MAINTENANCE_MODEL=claude-sonnet-4-20250514

# Optional operational identity shown by /v1/system and embedded in archives.
MARGINALIA_DEPLOYMENT_ID=household-compose

# The worker polls policy state; each workspace still controls enablement,
# manual/daily schedule, UTC hour, subdirectory, and retention in the UI.
MARGINALIA_BACKUP_POLL_SECONDS=900
